---
import { url } from '@/utils';
import { siteInfo } from '../site.config';
import DocsIcon from '@icons/document-code-twotone-rounded.svg';
import MenuOpenIcon from '@icons/transition-right-twotone-rounded.svg';
import MenuCloseIcon from '@icons/transition-left-twotone-rounded.svg';
import SearchModal from './SearchModal.astro';
---

<header class="sticky top-0 z-30 flex h-14 w-full items-center justify-between px-4 border-b border-b-neutral-300 bg-olive-100/80 backdrop-blur md:px-10">

  <div class="flex">

    <button
      id="menu-btn"
      type="button"
      aria-label="Show/hide the menu"
      class="relative w-7 h-7 cursor-pointer lg:w-6 lg:h-6"
      aria-controls="site-nav"
    >
      <MenuOpenIcon id="close-icon" class="absolute top-0 left-0 transition duration-700 xl:opacity-0" />
  
      <MenuCloseIcon id="open-icon" class="opacity-0 absolute top-0 left-0 transition duration-700 xl:opacity-100" />

    </button>

  </div>

  <a href={ url('') } class="absolute left-1/2 -translate-x-1/2 flex items-center font-bold text-zinc-700">

    <DocsIcon class="w-7 mr-2" />

    <div>{ siteInfo.title } { siteInfo.specVersion } { siteInfo.isDraft && 'Draft' }</div>

  </a>

  <SearchModal class="flex items-center" />

</header>